SERVICE_NAME=taskdemo
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/taskdemo?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EXCHANGE=taskdemo.events
RABBITMQ_QUEUE=taskdemo.task_completed
SHUTDOWN_TIMEOUT=5s
INFRA_OPTIONAL=false
MIGRATIONS_DIR=migrations/pgsql
